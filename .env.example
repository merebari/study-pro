# ── Study Pro environment template ─────────────────────────────
# Copy to .env and fill in your own values. NEVER commit .env.

# PostgreSQL connection string (required)
# Local dev:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Hosted (Neon / Supabase / Railway) example:
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/studypro?sslmode=require

# Secret that protects /api/bootstrap reseeding (recommended on production)
# BOOTSTRAP_SECRET=choose-a-long-random-string

# Netlify's Neon integration injects this automatically — no action needed:
# NETLIFY_DATABASE_URL=
